### Register a new user
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "testuser2",
  "email": "testuser2@example.com",
  "password": "TestPassword123"
}

### Login user
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "testuser2@example.com",
  "password": "TestPassword123"
}

### Logout user (replace {TOKEN} with your JWT)
POST http://localhost:5000/api/auth/logout
Authorization: Bearer {TOKEN}



######################### USER CRUD & ATTENDANCE #########################

### Create a new user
POST http://localhost:5000/api/users
Content-Type: application/json

{
  "name": "Site Incharge",
  "email": "siteincharge@example.com",
  "password": "Password123"
}

### Get all users
GET http://localhost:5000/api/users


######################### PROJECT CRUD #########################

### Create a new project
POST http://localhost:5000/api/project
Content-Type: application/json
Authorization: Bearer {TOKEN}

{
  "name": "Highway Project",
  "location": "Bhopal",
  "description": "Highway construction project.",
  "startDate": "2025-06-01",
  "endDate": "2026-06-01",
  "status": "Ongoing"
}

### Get all projects
GET http://localhost:5000/api/project

### Get a project by ID
GET http://localhost:5000/api/project/REPLACE_WITH_PROJECT_ID


######################### MACHINE CRUD & REFUEL #########################

### Add a machine to a project
POST http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines
Content-Type: application/json

{
  "name": "JCB",
  "type": "Excavator",
  "serialNumber": "JCB-12345",
  "fuelCapacity": 200
}

### Get all machines for a project
GET http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines

######################### MATERIAL CRUD & USAGE #########################

### Add a material to a project
POST http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/materials
Content-Type: application/json

{
  "name": "Cement",
  "quantity": 100,
  "unit": "bag"
}

### Get all materials for a project
GET http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/materials

### Get a material by ID
GET http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/materials/REPLACE_WITH_MATERIAL_ID

### Update a material
PUT http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/materials/REPLACE_WITH_MATERIAL_ID
Content-Type: application/json

{
  "quantity": 120
}

### Get all dumped materials
GET http://localhost:5000/api/materials


######################### EMPLOYEE CRUD #########################

### Add a new employee
POST http://localhost:5000/api/users
Content-Type: application/json
Authorization: Bearer {TOKEN}

{
  "name": "John Doe",
  "email": "johndoe@example.com",
  "password": "Password123",
  "role": "Engineer"
}

### Get all employees
GET http://localhost:5000/api/users
Authorization: Bearer {TOKEN}

