### Register a new user
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
  "name": "testuser2",
  "email": "testuser2@example.com",
  "password": "TestPassword123"
}

### Login user
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
  "email": "testuser2@example.com",
  "password": "TestPassword123"
}

### Logout user (replace {TOKEN} with your JWT)
POST http://localhost:5000/api/auth/logout
Authorization: Bearer {TOKEN}



######################### USER CRUD & ATTENDANCE #########################

### Create a new user
POST http://localhost:5000/api/users
Content-Type: application/json

{
  "name": "Site Incharge",
  "email": "siteincharge@example.com",
  "password": "Password123"
}

### Get all users
GET http://localhost:5000/api/users

### Log attendance for a user
POST http://localhost:5000/api/users/attendance
Content-Type: application/json

{
  "userId": "REPLACE_WITH_USER_ID",
  "date": "2025-06-09",
  "status": "present"
}

### Get attendance history for a user
GET http://localhost:5000/api/users/attendance/history?userId=REPLACE_WITH_USER_ID

### Reset password
POST http://localhost:5000/api/users/reset-password
Content-Type: application/json

{
  "email": "siteincharge@example.com"
}

### Change password
POST http://localhost:5000/api/users/change-password
Content-Type: application/json

{
  "userId": "REPLACE_WITH_USER_ID",
  "oldPassword": "Password123",
  "newPassword": "NewPassword456"
}

######################### PROJECT CRUD #########################

### Create a new project
POST http://localhost:5000/api/project
Content-Type: application/json
Authorization: Bearer {TOKEN}

{
  "name": "Highway Project",
  "location": "Bhopal",
  "description": "Highway construction project.",
  "startDate": "2025-06-01",
  "endDate": "2026-06-01",
  "status": "Ongoing"
}

### Get all projects
GET http://localhost:5000/api/project

### Get a project by ID
GET http://localhost:5000/api/project/REPLACE_WITH_PROJECT_ID

### Update a project
PUT http://localhost:5000/api/project/REPLACE_WITH_PROJECT_ID
Content-Type: application/json
Authorization: Bearer {TOKEN}

{
  "status": "Completed"
}

### Delete a project
DELETE http://localhost:5000/api/project/REPLACE_WITH_PROJECT_ID
Authorization: Bearer {TOKEN}

######################### MACHINE CRUD & REFUEL #########################

### Add a machine to a project
POST http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines
Content-Type: application/json

{
  "name": "JCB",
  "type": "Excavator",
  "serialNumber": "JCB-12345",
  "fuelCapacity": 200
}

### Get all machines for a project
GET http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines

### Get a machine by ID
GET http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines/REPLACE_WITH_MACHINE_ID

### Update a machine
PUT http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines/REPLACE_WITH_MACHINE_ID
Content-Type: application/json

{
  "status": "Under Maintenance"
}

### Log refuel for a machine
POST http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines/REPLACE_WITH_MACHINE_ID/refuel
Content-Type: application/json

{
  "litres": 50,
  "price": 100,
  "date": "2025-06-09"
}

### Get refuel history for a machine
GET http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines/REPLACE_WITH_MACHINE_ID/refuel/history

### Get GPS for a machine
GET http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/machines/REPLACE_WITH_MACHINE_ID/gps

######################### MATERIAL CRUD & USAGE #########################

### Add a material to a project
POST http://localhost:5000/api/projects/REPLACE_WITH_PROJECT_ID/materials
Content-Type: application/json

{
  "name": "Cement",
  "quantity": 100,
  "unit": "bag"
}

